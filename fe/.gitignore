# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts is committed: the standalone `tsc --noEmit` CI step runs without a
# prior `next build`, so it needs this file for the next/image-types module decls
# (*.ico/*.png imports). Next regenerates it on dev/build; it's marked do-not-edit.

# file take note about problems
Promlem.md