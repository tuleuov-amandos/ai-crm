# ─────────────────────────────────────────────────────────────
# Frontend env vars. Local: copy to `.env.local`. Vercel: set in
# Project Settings -> Environment Variables. Никаких реальных секретов в репо.
# ─────────────────────────────────────────────────────────────

# --- API ---
# Прямой адрес бэкенда — браузер ходит на него cross-origin (axios baseURL,
# OAuth-редирект, SSE). Без /api и без слэша на конце. В проде это домен
# Railway; на бэкенде FRONTEND_URL должен точно совпадать с доменом фронта,
# а куки идут с sameSite=none;secure + credentials CORS.
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Метаданные сайта ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXT_PUBLIC_SITE_LOCALE=ru_RU

# --- Sentry (опционально) ---
# Один DSN на всё приложение (клиент + server + edge). Не задан -> Sentry
# не инициализируется ни на одном рантайме.
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oyyyyy.ingest.sentry.io/zzzzz
# Необязательный отдельный DSN только для серверной/edge части; если не задан,
# сервер использует NEXT_PUBLIC_SENTRY_DSN.
# SENTRY_DSN=

# Только для загрузки source maps на этапе `next build` (CI / release-шаг).
# Без них сборка проходит, просто без загрузки карт (предупреждение).
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_xxx
