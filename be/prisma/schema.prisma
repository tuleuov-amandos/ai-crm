generator client {
  provider = "prisma-client"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  plan        String       @default("free")
  status      TenantStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  // ── Workspace profile (Settings → Workspace Info) ─────────────────────────
  // All optional; a fresh workspace has only `name` (set at sign-up). Editable
  // by ADMIN via PATCH /tenants/me. `industry` / `companySize` hold stable
  // keys ("it", "md", …) that the frontend maps to localized labels; `logoUrl`
  // is the Cloudinary secure URL (see CloudinaryService.uploadTenantLogo).
  website       String?
  address       String?
  companySize   String?
  industry      String?
  timezone      String?
  defaultLocale String?
  logoUrl       String?

  roles       Role[]
  activities  Activity[]
  contacts    Contact[]
  deals       Deal[]
  invitations Invitation[]
  kpiTargets  KpiTarget[]
  users       User[]
  auditLogs   AuditLog[]
  channels    Channel[]
  messages    Message[]
}

model User {
  id            String         @id @default(cuid())
  tenantId      String
  email         String         @unique
  name          String
  roleId        String
  role          Role           @relation(fields: [roleId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  password      String?
  avatarUrl     String?
  accounts      Account[]
  activities    Activity[]
  ownedContacts Contact[]      @relation("ContactOwner")
  ownedDeals    Deal[]         @relation("DealOwner")
  assignedTasks Task[]         @relation("TaskAssignee")
  kpiTargets    KpiTarget[]
  refreshTokens RefreshToken[]
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  auditLog      AuditLog[]

  // ── Chat (Settings → internal team chat) ──────────────────────────────────
  createdChannels    Channel[]       @relation("ChannelCreator")
  channelMemberships ChannelMember[]
  sentMessages       Message[]

  @@index([tenantId])
  @@index([roleId])
}

model Role {
  id          String           @id @default(cuid())
  tenantId    String           // Ensure multi-tenancy (SaaS): Each tenant can define its own role
  name        String           // "ADMIN", "MANAGER", "SALES_REP" or custom name
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  invitations Invitation[]
  permissions RolePermission[]
  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id          String           @id @default(cuid())
  action      String           // "manage", "create", "read", "update", "delete"
  subject     String           // "Contact", "Deal", "Task", "Activity", "User", "all"
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
  
  @@unique([action, subject])
}

model RolePermission {
  roleId       String
  permissionId String
  conditions   Json?           // Store ownership conditions (ABAC), e.g.: {"ownerId": "${user.id}"}
  
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Contact {
  id         String     @id @default(cuid())
  tenantId   String
  name       String
  email      String?
  phone      String?
  company    String?
  position   String?
  address    String?
  tags       String[]
  channel    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  ownerId    String
  activities Activity[]
  owner      User       @relation("ContactOwner", fields: [ownerId], references: [id])
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  deals      Deal[]

  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@index([tenantId, name])
}

model Deal {
  id            String         @id @default(cuid())
  tenantId      String
  contactId     String
  ownerId       String
  title         String
  value         Decimal        @default(0)
  stage         DealStage      @default(PROSPECT)
  isPaid        Boolean        @default(false)
  closeDate     DateTime?
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  activities    Activity[]
  aiSuggestions AiSuggestion[]
  contact       Contact        @relation(fields: [contactId], references: [id])
  owner         User           @relation("DealOwner", fields: [ownerId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  tasks         Task[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, ownerId])
}

model Activity {
  id        String       @id @default(cuid())
  tenantId  String
  contactId String?
  dealId    String?
  userId    String
  type      ActivityType
  note      String
  date      DateTime     @default(now())
  title     String?
  contact   Contact?     @relation(fields: [contactId], references: [id])
  deal      Deal?        @relation(fields: [dealId], references: [id])
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  // ── Attachment (Settings → Activity attachment) ───────────────────────────
  // At most one file per activity: a PDF, JPEG or PNG uploaded via
  // CloudinaryService.uploadActivityAttachment. `attachmentPublicId` is the
  // Cloudinary public_id, kept so we can delete the asset when the attachment
  // is replaced or the activity is removed.
  attachmentUrl      String?
  attachmentPublicId String?

  @@index([tenantId, contactId])
  @@index([tenantId, dealId])
}

model Task {
  id         String    @id @default(cuid())
  dealId     String
  title      String
  done       Boolean   @default(false)
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  tenantId   String
  assigneeId String?
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  assignee   User?     @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([tenantId, assigneeId])
}

// ── Chat (internal team chat — schema + REST API only; no WebSocket/realtime,
// no attachments, no frontend in this branch, see planned follow-ups) ────────
//
// Channels are created/removed by any user (Slack-style), never a fixed admin
// list. Every channel is visible tenant-wide — there is no per-channel read
// access control. ChannelMember exists purely for membership metadata (future
// unread counters / "who's in this channel"), not for gating access.
model Channel {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  createdById String
  createdAt   DateTime        @default(now())
  createdBy   User            @relation("ChannelCreator", fields: [createdById], references: [id])
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  members     ChannelMember[]
  messages    Message[]

  @@index([tenantId])
}

model ChannelMember {
  id        String   @id @default(cuid())
  channelId String
  userId    String
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([channelId, userId])
  @@index([channelId])
}

model Message {
  id          String               @id @default(cuid())
  channelId   String
  tenantId    String
  senderId    String
  content     String
  createdAt   DateTime             @default(now())
  editedAt    DateTime?
  channel     Channel              @relation(fields: [channelId], references: [id], onDelete: Cascade)
  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  sender      User                 @relation(fields: [senderId], references: [id])
  attachments MessageAttachment[]

  @@index([tenantId, channelId, createdAt])
}

model MessageAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  publicId  String
  fileName  String
  mimeType  String
  createdAt DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model AiSuggestion {
  id         String           @id @default(cuid())
  dealId     String
  type       AiSuggestionType
  content    String
  sourceNote String?
  createdAt  DateTime         @default(now())
  jobId      String
  tenantId   String
  deal       Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, dealId])
  @@index([tenantId, jobId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id        String           @id @default(cuid())
  tenantId  String
  email     String
  roleId    String
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)
  token     String           @unique
  status    InvitationStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime         @default(now())
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([token])
  @@index([roleId])
}


model KpiTarget {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  target    Decimal  @default(0)
  month     Int
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, month, year])
  @@index([tenantId, userId])
}
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String   // "CREATE", "UPDATE", "DELETE"
  targetType String   // "DEAL", "CONTACT"
  targetId   String
  targetName String?
  changes    Json     // Format: { [fieldName]: { old: any, new: any } }
  createdAt  DateTime @default(now())

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, targetType])
  @@index([tenantId, userId])
}

// Platform-level operator account. Deliberately NOT part of the tenant/User/Role
// system (no tenantId, no relation to Role — that model is namespaced per-tenant
// via @@unique([tenantId, name])). A PlatformAdmin authenticates through a
// separate cookie/JWT/strategy pair (see routes/platform-admin) whose payload
// never carries a tenantId, so TenantInterceptor never populates CLS for these
// requests and the Prisma tenant-scoping extension never filters them.
model PlatformAdmin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DealStage {
  PROSPECT
  QUALIFIED
  PROPOSAL
  CLOSED_WON
  CLOSED_LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
}

enum AiSuggestionType {
  TASK_LIST
  EMAIL_DRAFT
  SUMMARY
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum TenantStatus {
  PENDING
  ACTIVE
  SUSPENDED
}
