# ─────────────────────────────────────────────────────────────
# Backend env vars. Local: copy to `.env`. Railway: set in the
# service "Variables" tab. Никаких реальных секретов в репо.
# ─────────────────────────────────────────────────────────────

# --- Runtime ---
NODE_ENV=production
# На Railway PORT прокидывается автоматически; значение для локали.
PORT=3001

# --- Database (Railway Postgres) ---
# Строка подключения из плагина Railway Postgres + ?sslmode=require.
DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:5432/railway?sslmode=require
# Нужно только если DATABASE_URL указывает на хост в публичном интернете
# (напр. AWS RDS), чей сертификат не входит в доверенное хранилище Node.
# Путь к PEM CA-бандлу (для AWS RDS:
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem).
# Не нужно для localhost или приватной сети Railway (*.railway.internal).
# DATABASE_SSL_CA_PATH=./certs/rds-global-bundle.pem

# --- Redis (Railway Redis) ---
# Railway даёт один REDIS_URL (redis://default:<pass>@<host>:<port>).
# Приложение читает раздельные переменные — разбери URL на части:
#   REDIS_HOST     -> <host>
#   REDIS_PORT     -> <port>
#   REDIS_PASSWORD -> <pass> (часть после "default:")
#   REDIS_TLS      -> "true", если схема rediss://
REDIS_HOST=redis.railway.internal
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_TLS=false

# --- Auth / JWT ---
# Сгенерировать: openssl rand -hex 64
ACCESS_TOKEN_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-me-with-another-long-random-string
REFRESH_TOKEN_EXPIRES_IN=7d

# Домен для auth-кук. Пусто = localhost (dev).
# В проде — общий родительский домен, напр. .example.com
COOKIE_DOMAIN=

# --- Frontend / CORS ---
# Публичный адрес Vercel-деплоя (без завершающего слэша).
# Используется для CORS (app.enableCors) и редиректов.
FRONTEND_URL=https://your-app.vercel.app

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Должен совпадать с authorized redirect URI в Google Cloud Console.
GOOGLE_CALLBACK_URL=https://your-backend.up.railway.app/auth/google/callback

# --- AI provider ---
# AI_PROVIDER: "openai", "groq" или "anthropic".
AI_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=your-groq-key
# GROQ_MODEL=llama-3.3-70b-versatile
# Anthropic (Claude). Модель по умолчанию — claude-haiku-4-5 (дёшево, хватает
# для разбора заметок встреч). При недостаточном качестве поднять до
# claude-sonnet-5 здесь, без изменения кода.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-haiku-4-5

# --- Email (опционально, Resend) ---
# RESEND_API_KEY=your-resend-key
# RESEND_FROM_EMAIL=noreply@example.com

# --- Observability (опционально) ---
# DSN проекта Sentry. Не задан -> Sentry не инициализируется, приложение
# работает как раньше (в логах строка "Sentry disabled (no DSN)").
# SENTRY_DSN=https://xxxxx@oyyyyy.ingest.sentry.io/zzzzz
# Уровень логов pino: trace|debug|info|warn|error|fatal|silent.
# Не задан -> info в production, debug вне production. Можно поднять до debug
# на проде через Railway variable без пересборки.
# LOG_LEVEL=info
