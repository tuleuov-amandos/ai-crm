DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_saas"
# Only needed when DATABASE_URL points at a host reachable over the public internet
# (e.g. AWS RDS) whose certificate isn't in Node's default trust store. Point this at a
# PEM CA bundle (for AWS RDS: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem).
# Not needed for localhost or Railway's private *.railway.internal network.
# DATABASE_SSL_CA_PATH="./certs/rds-global-bundle.pem"

# Local-dev-only placeholders. In production these MUST be replaced with strong, unique
# secrets — the app refuses to start with these exact values when NODE_ENV=production.
ACCESS_TOKEN_SECRET="test-access-token-secret-local-only"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="test-refresh-token-secret-local-only"
REFRESH_TOKEN_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3001"

OPENAI_API_KEY="sk-test-dummy-key-for-local-dev"
OPENAI_MODEL="gpt-4o-mini"
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
AI_PROVIDER="openai"

REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_TLS=""

RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

GOOGLE_CLIENT_ID="dummy-google-client-id"
GOOGLE_CLIENT_SECRET="dummy-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"
